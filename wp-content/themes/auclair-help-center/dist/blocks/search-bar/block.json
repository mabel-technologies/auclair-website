{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/search-bar",
  "title": "Search Bar",
  "category": "auclair",
  "description": "Typeable search field. Enter searches kb_article.",
  "textdomain": "auclair",
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search queries or topics"
    },
    "action": {
      "type": "string",
      "default": "/search/?q=%s"
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "render": "file:./render.php",
  "version": "eca8a9daa9f7df1dcf7c303141cec87270d0f7fd878b6bd9a32573eda9a0e34c"
}