    "action": {
      "type": "string",
      "default": "/search/?q=%s"
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "viewScriptModule": "file:./view.js",
  "version": "31ed99c345936b82c22bc278c22aa6686023867c65b84f23912bc3f724daa728"
}