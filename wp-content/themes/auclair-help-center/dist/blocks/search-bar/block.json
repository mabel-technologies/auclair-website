{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/search-bar",
  "title": "Search Bar",
  "category": "auclair",
  "description": "Typeable search field. Enter searches kb_article.",
  "textdomain": "auclair",
  "attributes": {
    "placeholder": {
      "type": "string",
      "default": "Search for help…"
