{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/category-grid",
  "title": "Category Grid",
  "category": "auclair",
  "description": "Grid of category cards, one row of 4 on desktop, one per row on mobile.",
  "textdomain": "auclair",
  "attributes": {
    "taxonomy": {
      "type": "string",
      "default": "help_category"
    },
    "include": {
      "type": "array",
      "default": []
    },
    "columns": {
      "type": "number",
      "default": 4
    },
    "showCount": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "version": "3539b8538f1f3b91eed9ca3162df6e0091cd3cbe41dcc57b35be3e176f5221a5"
}