{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "auclair/category-grid",
    "title": "Category Grid",
    "category": "auclair",
    "description": "Grid of category cards, one row of 4 on desktop, one per row on mobile.",
    "textdomain": "auclair",
    "attributes": {
        "taxonomy": {
            "type": "string",
            "default": "help_category"
        },
        "include": {
            "type": "array",
            "default": []
        },
        "columns": {
            "type": "number",
            "default": 4
        },
        "showCount": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": false
    },
    "editorScript": "file:./index.tsx",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
