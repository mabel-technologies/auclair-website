{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "auclair/related-categories",
    "title": "Related Categories",
    "category": "auclair",
    "description": "Sibling category cards, excluding the current category.",
    "textdomain": "auclair",
    "attributes": {
        "termId": {
            "type": "number",
            "default": 0
        },
        "exclude": {
            "type": "array",
            "default": []
        },
        "limit": {
            "type": "number",
            "default": 3
        }
    },
    "supports": {
        "html": false,
        "align": false
    },
    "editorScript": "file:./index.tsx",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
