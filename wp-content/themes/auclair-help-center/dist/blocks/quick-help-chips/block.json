{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/quick-help-chips",
  "title": "Quick Help Chips",
  "category": "auclair",
  "description": "“Quick help” label + chips separated by hairline dividers.",
  "textdomain": "auclair",
  "attributes": {
