    "items": {
      "type": "array",
      "default": []
    },
    "limit": {
      "type": "number",
      "default": 4
    },
    "posts": {
      "type": "array",
      "default": []
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "viewScriptModule": "file:./view.js",
  "version": "874343a5d2b8b7c0667d173b452a2d59bcd17ac44e3129d28b5baf1012e3c68a"
}