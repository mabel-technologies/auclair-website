{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/category-card",
  "title": "Category Card",
  "category": "auclair",
  "description": "Icon, title, article count, with the hover ring animation.",
  "textdomain": "auclair",
  "attributes": {
    "termId": {
      "type": "number",
      "default": 0
    },
    "accent": {
      "type": "string",
      "default": ""
    },
    "animate": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "version": "23efeb30228fc2dbf1f51d370e696ae98ba331039aecd242cbb0289c71d0b9fb"
}