{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/top-queries",
  "title": "Top Queries",
  "category": "auclair",
  "description": "Vertical list of article links with dividers between.",
  "textdomain": "auclair",
  "attributes": {
    "source": {
      "type": "string",
      "default": "sticky"
    },
    "posts": {
      "type": "array",
      "default": []
    },
    "limit": {
      "type": "number",
      "default": 10
    },
    "boxed": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "version": "0e7074dbc708c4b6d68b35386e63697a1c8fea57df4c4278bde24d37023a108d"
}