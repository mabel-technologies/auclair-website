{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "auclair/top-queries",
  "title": "Top Queries",
  "category": "auclair",
  "description": "Vertical list of article links with dividers between.",
  "textdomain": "auclair",
  "attributes": {
    "source": {
      "type": "string",
      "default": "sticky"
    },
    "posts": {
      "type": "array",
      "default": []
    },
    "limit": {
      "type": "number",
      "default": 10
    },
    "boxed": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "align": false
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php",
  "version": "056f2767b62c3dc14ad0cd1f4d019d5047d117dc3daed92b1a317c654ec8812c"
}