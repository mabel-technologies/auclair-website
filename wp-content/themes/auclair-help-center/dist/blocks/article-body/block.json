{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "auclair/article-body",
    "title": "Article Body",
    "category": "auclair",
    "description": "Ordered step list (steps meta) followed by the article's post content.",
    "textdomain": "auclair",
    "attributes": {
        "postId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "align": false
    },
    "editorScript": "file:./index.tsx",
    "style": "file:./style.css",
    "render": "file:./render.php"
}
