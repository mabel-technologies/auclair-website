{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "auclair/section-heading",
	"title": "Section Heading",
	"category": "auclair",
	"description": "Section title with an optional subtitle.",
	"textdomain": "auclair",
	"attributes": {
		"title": {
			"type": "string",
			"default": "Section title"
		},
		"subtitle": {
			"type": "string",
			"default": ""
		},
		"align": {
			"type": "string",
			"default": "left"
		}
	},
	"supports": {
		"html": false,
		"align": false
	},
	"editorScript": "file:./index.tsx",
	"style": "file:./style.css"
}
