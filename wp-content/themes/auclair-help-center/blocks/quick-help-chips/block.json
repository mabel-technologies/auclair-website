{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "auclair/quick-help-chips",
	"title": "Quick Help Chips",
	"category": "auclair",
	"description": "“Quick help” label + chips separated by hairline dividers.",
	"textdomain": "auclair",
	"attributes": {
		"label": {
			"type": "string",
			"default": "Top Searches:"
		},
		"source": {
			"type": "string",
			"default": "popular"
		},
		"items": {
			"type": "array",
			"default": []
		},
		"limit": {
			"type": "number",
			"default": 4
		},
		"posts": {
			"type": "array",
			"default": []
		}
	},
	"supports": {
		"html": false,
		"align": false
	},
	"editorScript": "file:./index.tsx",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
