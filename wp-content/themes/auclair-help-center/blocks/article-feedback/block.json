{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "auclair/article-feedback",
	"title": "Article Feedback",
	"category": "auclair",
	"description": "“Was this article helpful?” + Yes/No, then thank-you message. Writes to kb_article meta via REST.",
	"textdomain": "auclair",
	"attributes": {
		"postId": {
			"type": "number",
			"default": 0
		},
		"upLabel": {
			"type": "string",
			"default": "Yes, thanks"
		},
		"downLabel": {
			"type": "string",
			"default": "Not really"
		},
		"thanksUp": {
			"type": "string",
			"default": "Thanks — glad it helped."
		},
		"thanksDown": {
			"type": "string",
			"default": "Thanks for letting us know — we’ll work on it."
		}
	},
	"supports": {
		"html": false,
		"align": false
	},
	"editorScript": "file:./index.tsx",
	"style": "file:./style.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
